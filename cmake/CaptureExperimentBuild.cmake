# Controlled build-step snapshot. No Git/CMake subprocesses at measurement time.
set(header "#pragma once\n#include <string_view>\nnamespace conway::app::build_info {\n")
function(field name value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(header "${header}inline constexpr std::string_view ${name} = \"${escaped}\";\n" PARENT_SCOPE)
endfunction()
field(compilerId "${COMPILER_ID}")
field(compilerVersion "${COMPILER_VERSION}")
field(compilerPath "${COMPILER_PATH}")
if(CONFIG STREQUAL "")
    set(CONFIG "unspecified")
endif()
field(buildType "${CONFIG}")
string(TIMESTAMP captured "%Y-%m-%dT%H:%M:%SZ" UTC)
field(capturedAt "${captured}")
find_program(snapshot_git git)
set(commit "")
set(state "")
if(snapshot_git)
    execute_process(COMMAND "${snapshot_git}" rev-parse --verify HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE git_result
        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT git_result EQUAL 0)
        set(commit "")
    else()
        execute_process(COMMAND "${snapshot_git}" status --porcelain --untracked-files=normal
            WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE status_result
            OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(status_result EQUAL 0)
            if(status STREQUAL "")
                set(state "clean")
            else()
                set(state "dirty")
            endif()
        endif()
    endif()
endif()
field(gitCommit "${commit}")
field(gitState "${state}")
foreach(name IN ITEMS sequential openmp benchmark comparison scaling)
    set(command_${name} "")
endforeach()
if(EXISTS "${BUILD_DIR}/compile_commands.json")
    file(READ "${BUILD_DIR}/compile_commands.json" commands)
    string(JSON count ERROR_VARIABLE json_error LENGTH "${commands}")
    if(NOT json_error AND count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON command GET "${commands}" ${index} command)
            string(JSON source GET "${commands}" ${index} file)
            if(MULTI_CONFIG)
                string(FIND "${command}" "CMakeFiles/conway_experiments.dir/${CONFIG}/" config_position)
                if(config_position EQUAL -1)
                    continue()
                endif()
            endif()
            if(command MATCHES "CMakeFiles/conway_experiments\\.dir/")
                if(source MATCHES "/src/core/engines/sequential\\.cpp$")
                    set(command_sequential "${command}")
                elseif(source MATCHES "/src/core/engines/openmp\\.cpp$")
                    set(command_openmp "${command}")
                elseif(source MATCHES "/src/app/benchmark\\.cpp$")
                    set(command_benchmark "${command}")
                elseif(source MATCHES "/src/app/experiment_runner\\.cpp$")
                    set(command_comparison "${command}")
                elseif(source MATCHES "/src/app/scaling_study\\.cpp$")
                    set(command_scaling "${command}")
                endif()
            endif()
        endforeach()
    endif()
endif()
foreach(name IN ITEMS sequential openmp benchmark comparison scaling)
    field(command_${name} "${command_${name}}")
endforeach()
string(APPEND header "}\n")
file(MAKE_DIRECTORY "${BUILD_DIR}/generated")
file(WRITE "${BUILD_DIR}/generated/experiment_build_info.tmp" "${header}")
configure_file("${BUILD_DIR}/generated/experiment_build_info.tmp"
               "${BUILD_DIR}/generated/experiment_build_info.hpp" COPYONLY)
